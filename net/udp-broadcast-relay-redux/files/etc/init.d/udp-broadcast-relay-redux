#!/bin/sh /etc/rc.common
# procd wrapper for udp-broadcast-relay-redux (UCI-driven, one instance per section)
START=99
USE_PROCD=1

PROG=/usr/bin/udp-broadcast-relay-redux
CONF=udp-broadcast-relay-redux

start_relay() {
	local section="$1"
	local disabled id
	config_get_bool disabled "$section" disabled 0
	[ "$disabled" = "1" ] && return 0
	config_get id "$section" id
	[ -z "$id" ] && { logger -t "$CONF" "section $section: missing id, skipped"; return 0; }

	local args="--id $id"
	local port dev mc
	for port in $(config_get "$section" port); do args="$args --port $port"; done
	for mc in $(config_get "$section" multicast); do args="$args --multicast $mc"; done
	for dev in $(config_get "$section" dev); do args="$args --dev $dev"; done

	procd_open_instance "$section"
	procd_set_param command "$PROG" $args
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
	logger -t "$CONF" "instance $section: $args"
}

start_service() {
	config_load "$CONF"
	config_foreach start_relay relay
}

service_triggers() {
	procd_add_reload_trigger "$CONF"
}
